+use bytemuck::Zeroable;
+use hook_runtime::{install_slot, modules::{max_wallet, volume_guard}, HookError};
+use hook_types::{HookCallback as Cb, HookSlot, ModuleId, MAX_HOOK_SLOTS};
+
+#[test]
+fn max_wallet_cannot_omit_the_after_check() {
+    let m=ModuleId::MaxWallet;
+    let mut slots=[HookSlot::zeroed();MAX_HOOK_SLOTS];
+    let result=install_slot(&mut slots,m as u16,m.info().default_priority,Cb::BeforeBuy.mask(),
+        m.info().capabilities,max_wallet::Config{max_base:100,start_ts:0,duration_secs:0}.encode());
+    assert_eq!(result,Err(HookError::BadCallbacks(m as u16)));
+    assert!(slots.iter().all(HookSlot::is_empty));
+}
+
+#[test]
+fn volume_guard_cannot_subscribe_twice_to_one_phase() {
+    let m=ModuleId::VolumeGuard;
+    let mut slots=[HookSlot::zeroed();MAX_HOOK_SLOTS];
+    let result=install_slot(&mut slots,m as u16,m.info().default_priority,
+        Cb::BeforeSwap.mask()|Cb::AfterSwap.mask()|Cb::AfterBuy.mask(),m.info().capabilities,
+        volume_guard::Config{max_buy_quote:100,max_sell_quote:100,window_secs:0,
+            window_max_quote:0,wallet_window_max_quote:0}.encode());
+    assert_eq!(result,Err(HookError::BadCallbacks(m as u16)));
+    assert!(slots.iter().all(HookSlot::is_empty));
+}
