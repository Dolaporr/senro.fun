+import {describe,it,expect} from 'vitest';
+import {PublicKey} from '@solana/web3.js';
+import {checkedRouteIx,readConfigurationHashIx,ixDiscriminator} from '../src/instructions.js';
+import {PUMP_HOOKS_PROGRAM_ID,TradeMode,Venue} from '../src/constants.js';
+const custom=new PublicKey(new Uint8Array(32).fill(11));
+const base={programId:custom,user:new PublicKey(new Uint8Array(32).fill(12)),market:new PublicKey(new Uint8Array(32).fill(13)),
+ venue:Venue.PumpSwap,mode:TradeMode.ExactQuoteIn,amount:100n,limit:10n,pumpAccounts:[],
+ expectedConfigurationHash:new Uint8Array(32).fill(7),deadlineSlot:123n};
+describe('SENRO checked route builders',()=>{
+ it('encodes configuration commitment and signed slot expiry',()=>{
+  const ix=checkedRouteIx(base);expect(ix.data.length).toBe(65);
+  expect(ix.data.subarray(0,8)).toEqual(Buffer.from(ixDiscriminator('route_amm_checked')));
+  expect(ix.data.subarray(25,57)).toEqual(Buffer.from(base.expectedConfigurationHash));
+  expect(ix.data.readBigUInt64LE(57)).toBe(123n);
+ });
+ it('selects the checked curve entrypoint',()=>{
+  const ix=checkedRouteIx({...base,venue:Venue.BondingCurve});
+  expect(ix.data.subarray(0,8)).toEqual(Buffer.from(ixDiscriminator('route_curve_checked')));
+ });
+ it('refuses the original mainnet ID',()=>{
+  expect(()=>checkedRouteIx({...base,programId:PUMP_HOOKS_PROGRAM_ID})).toThrow(/upstream mainnet/);
+  expect(()=>readConfigurationHashIx({market:base.market,programId:PUMP_HOOKS_PROGRAM_ID})).toThrow(/upstream mainnet/);
+ });
+ it('refuses omitted, zero, negative and overflowing trade bounds',()=>{
+  for(const limit of [0n,-1n,1n<<64n])expect(()=>checkedRouteIx({...base,limit})).toThrow(/bound/);
+  expect(()=>checkedRouteIx({...base,deadlineSlot:0n})).toThrow(/deadline/);
+  expect(()=>checkedRouteIx({...base,amount:0n})).toThrow(/amount/);
+ });
+ it('requires the complete fingerprint',()=>{
+  expect(()=>checkedRouteIx({...base,expectedConfigurationHash:new Uint8Array(31)})).toThrow(/32 bytes/);
+ });
+ it('can construct the read-only fingerprint instruction without signer privileges',()=>{
+  const ix=readConfigurationHashIx({market:base.market,programId:custom,policyIndexes:[0,2]});
+  expect(ix.keys.length).toBe(3);expect(ix.keys.every(k=>!k.isSigner&&!k.isWritable)).toBe(true);
+ });
+});
