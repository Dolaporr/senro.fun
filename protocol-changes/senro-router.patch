+// ---- SENRO checked routing (development fork only)
+export interface CheckedRouteArgs extends RouteArgs {
+  programId: PublicKey;
+  expectedConfigurationHash: Uint8Array;
+  deadlineSlot: bigint;
+}
+function developmentProgram(programId: PublicKey) {
+  if (!programId || programId.equals(PUMP_HOOKS_PROGRAM_ID)) {
+    throw new Error("Pass the separately deployed development program ID; upstream mainnet is refused");
+  }
+}
+function checkedU64(value: bigint, label: string) {
+  if (typeof value !== "bigint" || value <= 0n || value > (1n << 64n) - 1n) {
+    throw new Error(`${label} must be an explicit positive u64`);
+  }
+}
+export function checkedRouteIx(p: CheckedRouteArgs) {
+  developmentProgram(p.programId);
+  checkedU64(p.amount, "amount");
+  checkedU64(p.limit, "output/input bound");
+  checkedU64(p.deadlineSlot, "slot deadline");
+  if (p.expectedConfigurationHash.length !== 32) throw new Error("configuration hash must contain 32 bytes");
+  const base = routeIx(p);
+  return ix(p.venue === Venue.PumpSwap ? "route_amm_checked" : "route_curve_checked", base.keys,
+    (w) => w.u8(p.mode).u64(p.amount).u64(p.limit).fixed(p.expectedConfigurationHash, 32).u64(p.deadlineSlot), p.programId);
+}
+/** Simulate this instruction and read its 32-byte returnData. No wallet signature is needed. */
+export function readConfigurationHashIx(p: { market: PublicKey; policyIndexes?: number[]; programId: PublicKey }) {
+  developmentProgram(p.programId);
+  return ix("read_configuration_hash", [meta(p.market),
+    ...(p.policyIndexes ?? []).map(i => meta(hooksPda.policy(p.market, i, p.programId)))], undefined, p.programId);
+}
+
 // ---- SENTIENT
 
 /** Must be preceded in the same transaction by the Ed25519 verification of the signal. */
