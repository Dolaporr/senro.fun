+//! SENRO fork: commit to configuration, never to trade-mutated counters/state.
+use anchor_lang::{prelude::Pubkey,solana_program::hash::Hasher};
+use hook_types::{HookSlot,MAX_HOOK_SLOTS,MAX_POLICIES};
+use policy_vm::PolicyData;
+use crate::state::MarketConfig;
+
+pub fn fingerprint(market_key:&Pubkey,market:&MarketConfig,policies:&[PolicyData;MAX_POLICIES],mask:u8)->[u8;32]{
+    let mut config=*market;
+    config.routed_buy_quote=0;config.routed_sell_quote=0;config.trade_count=0;config.sequence=0;
+    let mut slots: [HookSlot;MAX_HOOK_SLOTS]=config.read_slots();
+    for slot in &mut slots {slot.state=[0;48];}
+    config.write_slots(&slots);
+    let mut h=Hasher::default();
+    h.hashv(&[b"senro:pump-configuration:v1",crate::ID.as_ref(),market_key.as_ref(),bytemuck::bytes_of(&config),&[mask]]);
+    for (index,p) in policies.iter().enumerate(){
+        if mask&(1<<index)==0 {continue;}
+        let mut policy=*p;
+        policy.registers=[0;4];policy.exec_count=0;policy.last_exec_ts=0;policy.intent=Default::default();
+        h.hashv(&[&[index as u8],bytemuck::bytes_of(&policy)]);
+    }
+    h.result().to_bytes()
+}
+
+#[cfg(test)] mod tests{
+    use super::*;
+    use bytemuck::Zeroable;
+    fn empty()->(MarketConfig,[PolicyData;MAX_POLICIES]){(MarketConfig::zeroed(),[PolicyData::zeroed();MAX_POLICIES])}
+    #[test]fn trade_counters_and_hook_state_do_not_invalidate_a_review(){
+        let(mut m,p)=empty();let key=Pubkey::new_unique();let before=fingerprint(&key,&m,&p,0);
+        m.sequence=10;m.trade_count=9;m.routed_buy_quote=99;m.routed_sell_quote=20;
+        let mut slots=m.read_slots();slots[0].state=[7;48];m.write_slots(&slots);
+        assert_eq!(before,fingerprint(&key,&m,&p,0));
+    }
+    #[test]fn rule_configuration_and_namespace_are_bound(){
+        let(mut m,p)=empty();let key=Pubkey::new_unique();let before=fingerprint(&key,&m,&p,0);
+        let mut slots=m.read_slots();slots[0].config[0]=1;m.write_slots(&slots);
+        assert_ne!(before,fingerprint(&key,&m,&p,0));
+        let(m,p)=empty();assert_ne!(fingerprint(&key,&m,&p,0),fingerprint(&Pubkey::new_unique(),&m,&p,0));
+    }
+    #[test]fn policy_counters_are_excluded_but_authored_actions_are_bound(){
+        let(m,mut p)=empty();let key=Pubkey::new_unique();let before=fingerprint(&key,&m,&p,1);
+        p[0].registers=[4;4];p[0].exec_count=7;p[0].last_exec_ts=42;p[0].intent.value=99;
+        assert_eq!(before,fingerprint(&key,&m,&p,1));
+        p[0].actions[0].value=10;assert_ne!(before,fingerprint(&key,&m,&p,1));
+    }
+}
